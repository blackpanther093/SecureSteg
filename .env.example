# .env.example - Environment Configuration

# ============================================
# ENVIRONMENT & MODE
# ============================================
ENVIRONMENT=development  # development | production
DEBUG=True              # Enable debug mode

# ============================================
# BACKEND SETTINGS
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ============================================
# FRONTEND SETTINGS
# ============================================
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=SecureSteg

# ============================================
# FILE UPLOAD SETTINGS
# ============================================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100
ALLOWED_IMAGE_FORMATS=png,jpg,jpeg,bmp,tiff,webp

# ============================================
# ENCRYPTION SETTINGS
# ============================================
DEFAULT_KEY_DERIVATION=pbkdf2  # pbkdf2 | argon2id
DEFAULT_ITERATIONS=100000
AES_KEY_SIZE=32  # 256-bit
NONCE_SIZE=12   # 96-bit (12 bytes)

# ============================================
# STEGANOGRAPHY SETTINGS
# ============================================
DEFAULT_EMBEDDING_METHOD=multi_layer  # lsb | multi_layer | dct
EMBEDDING_SAFETY_MARGIN=0.8  # Use 80% of capacity max
ENABLE_COMPRESSION=true

# ============================================
# SECURITY HEADERS
# ============================================
CORS_ORIGINS=*,http://localhost:3000,http://localhost:5173
ALLOW_CREDENTIALS=true
TRUSTED_HOSTS=localhost,127.0.0.1

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=/var/log/securesteg/app.log
DISABLE_PLAINTEXT_LOGGING=true  # NEVER log secrets

# ============================================
# DATABASE (OPTIONAL)
# ============================================
DATABASE_URL=mysql+pymysql://root:Goy%40l123@localhost/securesteg
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================
# SECURITY TOKENS & KEYS
# ============================================
SECRET_KEY=your-random-256-bit-hex-here  # Generate: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# RATE LIMITING
# ============================================
ENABLE_RATE_LIMITING=true
RATE_LIMIT_EMBED=10/minute  # Max embeddings per minute
RATE_LIMIT_EXTRACT=20/minute  # Max extractions per minute
RATE_LIMIT_DETECT=30/minute   # Max detections per minute

# ============================================
# CACHE SETTINGS (OPTIONAL)
# ============================================
CACHE_TYPE=redis  # redis | memory
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ============================================
# BACKUP & STORAGE
# ============================================
BACKUP_ENABLED=true
BACKUP_DIRECTORY=/backup/securesteg
BACKUP_FREQUENCY=daily  # daily | weekly | monthly
AWS_S3_BUCKET=securesteg-backups  # Optional S3 storage

# ============================================
# MONITORING & METRICS
# ============================================
ENABLE_METRICS=true
PROMETHEUS_PORT=9090
ENABLE_SENTRY=false  # Error tracking
SENTRY_DSN=

# ============================================
# SMTP (OPTIONAL - for notifications)
# ============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@securesteg.com

# ============================================
# DEVELOPMENT ONLY
# ============================================
SKIP_VALIDATION=false
AUTO_RELOAD=true
MOCK_ENCRYPTION=false  # NEVER enable in production

# ============================================
# NOTES
# ============================================
# 1. Never commit this file with actual values
# 2. Generate SECRET_KEY: openssl rand -hex 32
# 3. Use strong passwords for SMTP/DATABASE
# 4. Keep JWT_SECRET secure
# 5. Different secrets for dev/prod environments
